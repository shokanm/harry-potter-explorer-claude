# ─────────────────────────────────────────────────────────────
# Harry Potter Explorer — переменные окружения
#
# Скопируйте этот файл в .env.local и заполните. Приложение запускается
# и работает даже с полностью пустым .env.local: без Supabase оно читает
# hp-api напрямую, без ключа Gemini молчат портреты и Шляпа. Ключи нужны
# только чтобы включить соответствующие возможности.
#
# Обратите внимание: ни одной переменной с префиксом NEXT_PUBLIC_.
# Это намеренно — в браузер не должен попадать ни один адрес и ни один ключ.
# ─────────────────────────────────────────────────────────────

# ── Внешний источник данных (по умолчанию уже верный, менять не нужно) ──
HP_API_BASE_URL=https://hp-api.onrender.com/api
# Сколько ждать ответа. hp-api живёт на бесплатном Render и после простоя
# просыпается до минуты — ждать столько нельзя, лучше уйти на снапшот.
HP_API_TIMEOUT_MS=8000
# Время жизни кэша ISR для upstream-запросов, секунды.
HP_API_REVALIDATE=3600
# Время жизни разобранного каталога в памяти процесса, миллисекунды.
DATA_CACHE_TTL_MS=300000

# ── Supabase ──
# Создайте проект на supabase.com, выполните supabase/schema.sql
# в SQL Editor, затем возьмите значения в Settings → API Keys.
SUPABASE_URL=

# Ключ чтения. В новых проектах Supabase он называется publishable
# и выглядит как sb_publishable_… — его и вписывайте сюда.
SUPABASE_PUBLISHABLE_KEY=
# Старое имя того же ключа (JWT из вкладки Legacy API keys).
# Заполняйте только если ваш проект ещё на старых ключах.
SUPABASE_ANON_KEY=

# Ключ записи, только для сервера: обходит RLS, публиковать нельзя.
# В новых проектах называется secret и выглядит как sb_secret_…
SUPABASE_SECRET_KEY=
# Старое имя того же ключа.
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini ──
# Ключ бесплатного тарифа: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Верхняя граница длины ответа портрета. Держит и стоимость, и характер:
# портреты не читают лекций.
GEMINI_MAX_TOKENS=320

# ── Прочее ──
# Соль для хэширования IP в ограничителе частоты. Задайте любую случайную
# строку — от неё зависит, что нельзя восстановить адрес по записи в базе.
RATE_LIMIT_SALT=
